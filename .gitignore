.vscode/
.idea/

*.swp
*.swo
*~
.project
.pydevproject


# ==============================================================================
# Operating-system files
# ==============================================================================

.DS_Store
Thumbs.db
desktop.ini


# ==============================================================================
# Temporary pipeline configuration files
# ==============================================================================
#
# The orchestration scripts generate temporary per-run configuration files.
# These files are implementation artifacts and must never be committed.

.base_run_config.yaml
.base_evaluation_config.yaml

.finetuning_run_config.yaml
.finetuned_evaluation_config.yaml

.continued_control_run_config.yaml
.continued_control_evaluation_config.yaml

.smoke_bootstrap_config.yaml

# General protection for equivalent temporary configurations.
.*_run_config.yaml
.*_evaluation_config.yaml


# ==============================================================================
# INTERNAL SMOKE TESTS
# ==============================================================================
#
# Smoke-test scripts were used only during internal development and validation.
# They are intentionally excluded from the public reproduction workflow.

smoke_*.py

models/smoke_test/
results/smoke_test/


# ==============================================================================
# TEMPORARY END-TO-END SIMULATION ARTIFACTS
# ==============================================================================
#
# These artifacts were generated only to validate the complete pipeline before
# the definitive experiments. They are not scientific results.

models/e2e_simulation/
results/e2e_simulation/


# ==============================================================================
# RESEARCH DATA
# ==============================================================================
#
# Neither the biblical corpus nor the conversational corpus is redistributed.
#
# The repository provides the acquisition, extraction, preprocessing, alignment,
# splitting, and tokenization code required to reconstruct the datasets from
# their respective original sources.
#
# Source information, rights notes, and reconstruction instructions are
# documented in data/README.md.


# ------------------------------------------------------------------------------
# Raw source data
# ------------------------------------------------------------------------------

data/raw/


# ------------------------------------------------------------------------------
# Intermediate data
# ------------------------------------------------------------------------------

data/interim/


# ------------------------------------------------------------------------------
# Cleaned / aligned corpora
# ------------------------------------------------------------------------------

data/clean/


# ------------------------------------------------------------------------------
# Train / validation / test splits
# ------------------------------------------------------------------------------

data/splits/


# ------------------------------------------------------------------------------
# Encoded / tokenized datasets
# ------------------------------------------------------------------------------

data/tokenized/


# ==============================================================================
# MODEL CHECKPOINTS
# ==============================================================================
#
# Neural-network checkpoints are generated by the public training pipeline and
# are not stored in the source-code repository.

/models/

*.pt
*.pth
*.ckpt


# ==============================================================================
# EXPERIMENTAL RESULTS
# ==============================================================================
#
# Lightweight scientific outputs such as JSON metric files, training summaries,
# training-history CSV files, and bootstrap summaries are intentionally allowed
# to be versioned.
#
# Prediction TSV files are excluded because they contain reference sentences
# originating from the research corpora.

results/**/*.tsv
results/*predictions*.tsv
results/**/*predictions*.tsv

# Additional protection against accidentally committing exported references or
# hypotheses in text-table form.

results/*references*.tsv
results/**/*references*.tsv
results/*hypotheses*.tsv
results/**/*hypotheses*.tsv


