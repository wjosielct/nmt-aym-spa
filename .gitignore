*.py[cod]
*$py.class
*.pyo

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/


# ==============================================================================
# Jupyter / notebook caches
# ==============================================================================

.ipynb_checkpoints/


